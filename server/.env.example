ANTHROPIC_API_KEY=

# Postgres — POSTGRES_PASSWORD is required; docker-compose will not start without it.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_COLLECTION_NAME=memories

ADMIN_API_KEY=
JWT_SECRET=
# Local development only. Leave false in production.
AUTH_DISABLED=false
DASHBOARD_URL=http://localhost:3000
APP_DB_NAME=mem0_app

# Anthropic LLM and local Ollama embedder configuration.
MEM0_DEFAULT_LLM_MODEL=claude-haiku-4-5-20251001
# nomic-embed-text is English-first: a query retrieves memories in its own
# language ahead of the memory that answers it. embeddinggemma covers 100+
# languages at the same 768 dimensions. Changing this model invalidates every
# stored vector — point POSTGRES_COLLECTION_NAME at a new collection and
# refill it with server/reembed_collection.py before switching.
MEM0_DEFAULT_EMBEDDER_MODEL=nomic-embed-text
# Must match the selected embedding model and the pgvector collection.
MEM0_EMBEDDING_DIMS=768
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_IMAGE=ollama/ollama:0.32.3

# Reranker. Empty disables it; search then returns raw vector order, whose
# scores cannot separate a hit from its nearest neighbour. Only llm_reranker
# is bundled — it reuses MEM0_DEFAULT_LLM_MODEL unless overridden, and costs
# one model call per search that passes rerank=true.
MEM0_RERANKER_PROVIDER=
# MEM0_RERANKER_MODEL=claude-haiku-4-5-20251001

# Anonymous telemetry. Sends a single onboarding event per install
# (install UUID, email domain, server version, source). No PII.
# Set to false to opt out.
MEM0_TELEMETRY=true

# Days of request_logs history to keep when `make prune-logs` runs.
# Wire the prune command into cron/systemd in production.
REQUEST_LOG_RETENTION_DAYS=30

# Used by each local Claude plugin process, not by the server container:
# MEM0_API_URL=https://mem0.example.internal
# MEM0_API_KEY=m0sk_personal_key_from_dashboard
